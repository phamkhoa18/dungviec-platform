        <mxCell id="note" value="Quy tắc: chỉ HR sở hữu tin tuyển dụng được cập nhật trạng thái. Mọi lần chuyển trạng thái phải cập nhật updated_at và có thể kèm hr_notes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="650" width="800" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>