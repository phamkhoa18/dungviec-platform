# Sao chép thành .env.local rồi chỉnh sửa

# Khoá ký phiên đăng nhập (đặt chuỗi ngẫu nhiên dài khi triển khai thật)
JWT_SECRET=doi-thanh-chuoi-bi-mat-cua-ban

# Kết nối MongoDB thật (Local mặc định hoặc MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=dungviec_ai_recruitment

# Địa chỉ Python AI Service (mặc định http://127.0.0.1:8008)
AI_SERVICE_URL=http://127.0.0.1:8008

# Cấu hình SMTP gửi email OTP quên mật khẩu (VD: Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Đúng Việc <your-email@gmail.com>"
